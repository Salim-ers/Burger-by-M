# =====================================================================
#  BURGER BY M — variables d'environnement (NOMS UNIQUEMENT)
#  Copier en .env.local (développement) ou les saisir dans Vercel.
#  Ne jamais committer de vraie valeur. Aucun secret ne doit être
#  préfixé NEXT_PUBLIC_ (ces variables sont envoyées au navigateur).
# =====================================================================

# --- Base de données : Neon (PostgreSQL) -----------------------------
# Chaîne de connexion « pooled » Neon (…-pooler…neon.tech/…?sslmode=require).
DATABASE_URL=
# Taille du pool (5 par défaut ; 1 avec la base locale PGlite).
DATABASE_POOL_MAX=

# --- Authentification administration : Better Auth -------------------
# Secret aléatoire de 32 caractères minimum (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# URL publique du site (https://…), utilisée par Better Auth.
BETTER_AUTH_URL=

# --- Site -------------------------------------------------------------
# URL publique (canonical, sitemap, OpenGraph, retours de paiement).
NEXT_PUBLIC_APP_URL=

# --- Paiement en ligne : Mollie ---------------------------------------
# Clé API du profil Mollie (test_… pour les essais, live_… en production).
# Serveur uniquement : jamais de préfixe NEXT_PUBLIC_.
MOLLIE_API_KEY=
# manual (défaut) : montant autorisé à la commande, encaissé quand la cuisine
# ACCEPTE, autorisation annulée si elle REFUSE.
# automatic : débit immédiat, remboursement intégral en cas de refus.
MOLLIE_CARD_CAPTURE=

# --- Notifications Web Push (tablette cuisine) ------------------------
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:contact@… ou https://…
VAPID_SUBJECT=

# --- Email de confirmation (optionnel) : Resend -----------------------
RESEND_API_KEY=
# Ex. : Burger By M <commandes@domaine.fr> (domaine vérifié chez Resend)
EMAIL_FROM=
