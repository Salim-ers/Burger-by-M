{
  "name": "burger-by-m",
  "version": "0.1.0",
  "private": true,
  "description": "Site officiel, carte, commande en ligne (Stripe), écran cuisine PWA et back-office de Burger By M — Rantigny",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-prepare.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:local": "node scripts/dev-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "media:products": "node scripts/media/extract-product-photos.mjs",
    "media:cutouts": "node scripts/media/cutout.mjs",
    "media:icons": "node scripts/media/pwa-icons.mjs",
    "vapid:generate": "web-push generate-vapid-keys"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
